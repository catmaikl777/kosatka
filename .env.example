# ============================================================
#  PIXEL ORCA — переменные окружения бэкенда
#  Скопируй в .env и подставь свои значения (для PaaS — в настройках сервиса).
#  Сервер читает ТОЛЬКО окружение, файла .env нет: на Render/Railway/Fly
#  переменные задаются в панели или через fly secrets set / render env.
# ============================================================

# ---- сеть ----
# Порт и хост приходят от платформы автоматически (PORT подставляет Render/Railway/Fly)
PORT=8081
HOST=0.0.0.0

# Публичный адрес сервиса — только для красоты в логах при старте
PUBLIC_URL=https://kosatka.onrender.com

# ---- база данных (главное для PaaS!) ----
# На бесплатных тарифах файловая система эфемерна: после деплоя/рестарта
# аккаунты, кланы и облачные сейвы пропадут. Нужен постоянный диск:
#   Render  → disk, mountPath /data
#   Fly     → fly volumes create kosatka_data, монтирование в /data
#   Railway → volume, монтирование в /data
#   VPS     → любой каталог на диске
DATA_FILE=/data/db.json

# ---- бэкап базы в репозиторий GitHub (если тома нет) ----
# Если диска-тома не будет, аккаунты пропадут при каждом редеплое.
# Спасает приватный репозиторий: сервер кладёт туда копию базы и
# при старте с пустой базой восстанавливает её оттуда.
#   1) создай ПРИВАТНЫЙ репозиторий (например kosatka-data) — он не должен
#      быть публичным: в снимке лежат хеши паролей и токены сессий;
#   2) создай токен GitHub (Settings → Developer settings → Personal access
#      tokens → Fine-grained) с правом Contents: Read and write
#      ТОЛЬКО на этот репозиторий;
#   3) задай BACKUP_REPO и BACKUP_TOKEN в настройках сервиса.
# Без обеих переменных бэкап просто выключен и локальная разработка
# ничем не отличается.
BACKUP_REPO=catmaikl777/kosatka-data
BACKUP_TOKEN=github_pat_xxxxxxxxxxxx
# необязательно:
# BACKUP_PATH=db.json          файл в репозитории
# BACKUP_BRANCH=main           ветка
# BACKUP_EVERY_MS=300000       как часто выкладывать снимок (мин. 30 с)
# BACKUP_API=https://api.github.com   другой API (GitHub Enterprise)

# ---- геймплей ----
PVP_MS=30000
RAID_MS=60000
TICK=250
SEASON_MS=2592000000

# ---- статика (необязательно) ----
# Если фронт живёт на GitHub Pages, бэкенду статика не нужна и её можно не отдавать.
# Путь к папке с клиентом внутри контейнера/репозитория:
# STATIC_DIR=/app
#   Docker-образ:        /app
#   Render (из репозитория): /opt/render/project/src
#   Fly:                 /app
# Если переменная не задана, сервер берёт папку с клиентом рядом с server/.
